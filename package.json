{
  "name": "omnai",
  "version": "0.3.0",
  "description": "A lightweight local-first AI engineering workflow for repository and personal multi-project work",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "omnai": "dist/src/main.js"
  },
  "files": [
    "dist",
    "!dist/src/core/git-provider/test/**",
    "!dist/test/package-version.test.*",
    "scripts/run-native-tests.mjs",
    "resources",
    "skills",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "node scripts/build-native-provider.mjs",
    "build:native:test": "node scripts/build-native-provider.mjs --test-harness",
    "build": "npm run build:native && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-native-tests.mjs",
    "test:adversarial": "npm run build && node scripts/run-adversarial-tests.mjs",
    "check:transition": "tsc src/tooling/diagnostic-ownership.ts --rootDir . --outDir dist --declaration false --sourceMap false --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --skipLibCheck --pretty false && node scripts/check-v0.3-transition-ownership.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.0.0",
    "commander": "^14.0.0",
    "xstate": "^5.19.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "ai",
    "workflow",
    "coding-agent",
    "spec-driven-development",
    "context-engineering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davisjiahao/omnai.git"
  }
}
